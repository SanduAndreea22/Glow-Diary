# Copiază acest fișier în `.env` (local) și completează valorile.
# În producție, setează aceleași variabile direct pe server/platformă —
# nu folosi niciodată un fișier `.env` commis în git.

# Obligatoriu. Generează una nouă cu:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True doar în dezvoltare locală. În producție trebuie False.
DEBUG=True

# Domenii permise, separate prin virgulă. Ex: glowdiary.com,www.glowdiary.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origini de încredere pentru CSRF în producție (cu schema https://), separate prin virgulă.
# Ex: https://glowdiary.com,https://www.glowdiary.com
CSRF_TRUSTED_ORIGINS=

# Cache partajat pentru rate limiting — recomandat în producție (obligatoriu
# dacă rulezi mai mult de un worker). Fără el, se folosește LocMemCache
# (doar pentru dezvoltare locală, un singur proces).
REDIS_URL=

# Setează True DOAR dacă ești sigur(ă) că platforma de hosting suprascrie
# (nu doar adaugă la) header-ul X-Forwarded-For înainte să ajungă la aplicație
# (ex. Render, Heroku, Fly.io). Altfel, rămâne False — rate limiting-ul
# folosește doar adresa IP reală a conexiunii.
TRUST_X_FORWARDED_FOR=False

# Email — pentru notificarea erorilor 500 și alte emailuri ale site-ului.
# Fără EMAIL_HOST setat, emailurile se scriu în consolă (dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@glowdiary.com
SERVER_EMAIL=no-reply@glowdiary.com

# Emailul lui Deea — primește notificare automată la fiecare eroare 500.
ADMIN_EMAIL=

# URL-ul panoului de admin. Schimbă din "admin/" în producție (hardening minim).
ADMIN_URL=admin/

# Redirect automat la HTTPS în producție (implicit True când DEBUG=False).
SECURE_SSL_REDIRECT=True

# Setează True DOAR dacă ești sigur(ă) că platforma de hosting termină SSL
# la un proxy din față și trimite corect header-ul X-Forwarded-Proto
# (comun pe PaaS-uri, inclusiv PythonAnywhere). Fără asta corect, dar cu
# SECURE_SSL_REDIRECT=True, site-ul intră în redirect infinit ("too many
# redirects") — verifică manual pe domeniul real înainte de lansare.
TRUST_X_FORWARDED_PROTO=False
